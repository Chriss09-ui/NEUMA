import type { UnknownRecord } from "./json.mjs";
export interface GroupMember { id: string; name?: string | undefined; revision: number; capabilityVersion?: string | undefined }
export interface GroupCapability { id: string; scope: string; availability: string; reason?: string | undefined; requiresNetwork?: boolean | undefined }
export interface MemberCard { id: string; name: string; ready: boolean; revision?: number | null | undefined; capabilityVersion?: string | undefined; description?: string | undefined; capabilities?: GroupCapability[] | undefined }
export interface GroupSender { type: string; id: string; name?: string | undefined }
export interface GroupMention { memberId: string; start: number; end: number; text: string }
export interface ReplyRequest { recipientId: string; kind: string }
export interface ReplyAudience { mode: string; memberIds: string[] }
export interface GroupRoute { mode: string; memberIds?: string[] | undefined; question?: string | undefined }
export interface GroupRouting extends GroupRoute { memberIds: string[]; sourceMessageId: string; generation: number }
export interface ReplySubmission { reply: string; replyStatus: string; replyRecipientId?: string | undefined; replyRequest?: ReplyRequest | undefined }
export interface GroupIntent { participate: boolean; contribution: string; willingToIntegrate: boolean; integratorId: string | null; interaction?: string | undefined; reply?: string | undefined; replyStatus?: string | undefined; replyRecipientId?: string | undefined; replyRequest?: ReplyRequest | undefined; replyAudience?: ReplyAudience | undefined }
export interface StoredIntent extends GroupIntent { agentId: string; round: number; failed?: boolean | undefined; replyMessageId?: string | undefined }
export interface GroupMessage { id: string; sender: GroupSender; content: string; taskId: string | null; recipientId: string | null; replyTo: string | null; status: string; createdAt: string; seq: number; visibility?: string | undefined; kind?: string | undefined; mentionIds?: string[] | undefined; mentions?: GroupMention[] | undefined; replyRequest?: ReplyRequest | undefined; replyRequestStatus?: string | undefined; replyAudience?: ReplyAudience | undefined; replyRouting?: GroupRouting | undefined }
export interface GroupEvent extends UnknownRecord { type: string; groupId: string; seq: number; createdAt: string; taskId?: string | null | undefined; agentId?: string | null | undefined; phase?: string | undefined; status?: string | undefined; messageId?: string | undefined; childId?: string | null | undefined }
export interface GroupJob { id: string; agentId: string; childId: string | null; kind: string; messageId: string | null; status: string; createdAt: string; routeResolved?: boolean | undefined; intentChecked?: boolean | undefined; replyMessageId?: string | undefined }
export interface WorkRequest { capabilityId?: string | undefined; capabilityVersion?: string | undefined; inputs?: string | undefined; expectedOutput?: string | undefined; acceptance?: string | undefined }
export interface GroupChild extends WorkRequest { id: string; title: string; description: string; assigneeId: string | null; required: boolean; dependsOn: string[]; pendingQuestions: string[]; status: string; result: string; reason?: string | undefined; artifactIds: string[]; createdAt: string; updatedAt: string; requesterId?: string | undefined }
export interface GroupQuestion { id: string; askerId: string; recipientId: string; childId: string | null; parentQuestionId: string | null; status: string; result?: string | undefined; reason?: string | undefined; answerId?: string | undefined }
export interface RelayRequest extends ReplyRequest { id: string; sourceMessageId: string; requesterId: string; chainId: string; depth: number; visitedIds: string[]; status: string; result?: string | undefined; reason?: string | undefined; replyMessageId?: string | undefined; reservedTurns?: number | undefined }
export interface CompletionState { phase?: string | undefined; status: string; reason?: string | undefined }
export interface ReplyRelay { sourceMessageId: string | undefined; generation: number; status: string; requests: RelayRequest[]; completion: CompletionState; needsInput: string[]; failures: string[]; limited?: boolean | undefined }
export interface GroupTask extends CompletionState { toolReceipts?: { id: string; hash: string; result: unknown }[] | undefined; id: string; conversationId?: string | undefined; groupId?: string | undefined; goal: string; ownerId?: string | null | undefined; participants: GroupMember[]; requestedRecipientId: string | null; requestedRecipientIds?: string[] | undefined; attachmentIds?: string[] | undefined; children: GroupChild[]; jobs: GroupJob[]; intents?: StoredIntent[] | undefined; requests: { id: string; agentId: string; capability: string; reason: string; status: string; createdAt: string }[]; negotiationRound?: number | undefined; turnsUsed?: number | undefined; generation: number; result: string; createdAt: string; updatedAt: string; taskAllowNetwork?: boolean | undefined; questions?: GroupQuestion[] | undefined; artifactIds?: string[] | undefined; replyRelay?: ReplyRelay | undefined; replyRelayHistory?: ReplyRelay[] | undefined; replyAudience?: ReplyAudience | undefined; replyRouting?: GroupRouting | undefined; continuationState?: CompletionState | undefined; integrationSignature?: string | null | undefined }
export interface Group { id: string; name: string; purpose: string; memberIds: string[]; archived: boolean; materialIds: string[]; version: number; createdAt: string; updatedAt: string; lastSequence: number; activeTaskId: string | null; creationId: string; creationHash: string }
export interface GroupArtifact { id: string; name: string | undefined; path: string; agentId: string; taskId: string | null; content: string; hash: string; size: number; createdAt: string }
export interface GroupMutationResult extends UnknownRecord { taskId?: string | undefined; messageId?: string | undefined; attachment?: { id: string } | undefined }
export interface GroupRecord { schemaVersion: 1; group: Group; tasks: GroupTask[]; messages: GroupMessage[]; events: GroupEvent[]; artifacts: GroupArtifact[]; mutations: { id: string; hash: string; result: GroupMutationResult }[]; deletedConversations?: { id: string; taskIds: string[]; deletedAt: string }[] | undefined }
export interface TurnSubmission { status: string; result: string; reason: string; artifactIds: string[]; replyRecipientId?: string | undefined; replyRequest?: ReplyRequest | undefined }
export interface CollaborationLimits { concurrentMembers: number; negotiationRounds: number; executionTurns: number; turnLimit: number; publicReplyDepth: number; publicReplyCount: number; publicReplyTurns: number; recordBytes: number }
