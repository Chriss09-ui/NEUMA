import type { UnknownRecord } from "./json.mjs";
export interface OAuthConfiguration { issuer?: string | undefined; authorizationUrl?: string | undefined; tokenUrl?: string | undefined; clientId?: string | undefined; clientSecret?: string | undefined; scopes?: string[] | undefined; resource?: string | undefined; registrationUrl?: string | undefined; issuerParameterSupported?: boolean | undefined }
export interface OAuthTokens { accessToken: string; refreshToken?: string | undefined; expiresAt: number | null; scopes: string[] }
export interface ConnectionCredentials extends UnknownRecord { secret?: string; secretValues?: Record<string, string>; tokens?: OAuthTokens }
export type ConnectionMapping = string | { from?: string; config?: string; credential?: string; literal?: unknown };
export interface ConnectionRequest { path?: Record<string, ConnectionMapping>; query?: Record<string, ConnectionMapping>; headers?: Record<string, ConnectionMapping>; body?: Record<string, ConnectionMapping>; bodyFrom?: string; encoding?: string }
export interface ConnectionOperation { id: string; description?: string | undefined; method?: string | undefined; path?: string | undefined; input?: string; output?: string; safeTest?: boolean | undefined; readOnly?: boolean | undefined; testInput?: UnknownRecord; inputSchema?: UnknownRecord | undefined; outputSchema?: UnknownRecord | undefined; tool?: string | undefined; resourceUri?: string | undefined; timeoutMs?: number; request?: ConnectionRequest }
export interface ConnectionField { key: string; label: string; type: string; required?: boolean; options?: (string | { value: string; label: string })[]; optionsFrom?: { operationId: string; valuePath: string; labelPath: string; itemsPath?: string } }
export interface ConnectionDefinition extends UnknownRecord { id: string; purpose?: string; kind?: string; required?: boolean; description?: string; label?: string; protocol?: string; configFields?: ConnectionField[] | undefined; operations: ConnectionOperation[] }
export interface MCPToolDescription { name: string; title?: string | undefined; description?: string | undefined; inputSchema: UnknownRecord; outputSchema?: UnknownRecord | undefined; annotations?: UnknownRecord | undefined; contractHash: string }
export interface MCPResourceDescription { uri: string; name: string; description?: string | undefined; mimeType?: string | undefined; contractHash: string }
export interface ConnectionDiscovery { tools?: MCPToolDescription[]; resources?: MCPResourceDescription[]; operations?: ConnectionOperation[]; requiresReview?: boolean }
export interface ConnectionConfiguration extends ConnectionCredentials { id: string; kind: string; provider: string; baseUrl: string; model: string; authType: string; headerName: string; allowFallback: boolean; protocol: string; username: string; values: UnknownRecord; oauth?: OAuthConfiguration | undefined }
export type ConnectionRuntimeConfiguration = Pick<ConnectionConfiguration, "id" | "kind" | "authType"> & Partial<ConnectionConfiguration>;
export interface ConnectionVersion extends ConnectionRuntimeConfiguration { version: number; generation: string; grantEpoch?: number; status?: string; updatedAt?: string; testedAt?: string | null; reason?: string | null; credentialRef?: string | undefined; discovery?: ConnectionDiscovery | undefined; pendingDiscovery?: ConnectionDiscovery | undefined; discoveryRequirementHash?: string | undefined; configurationChoices?: Record<string, { value: string; label: string }[]> | undefined }
export interface ConnectionEntry { id: string; generation: string; currentVersion: number; grantEpoch?: number; versions: Record<number, ConnectionVersion> }
export interface ConnectionSection { schemaVersion: 1; agentId: string; version: number; connections: Record<string, ConnectionEntry> }
export interface ConnectionRoot extends ConnectionSection, UnknownRecord { activeProfile?: string; profiles?: Record<string, ConnectionSection>; revokedGenerations?: Record<string, boolean> }
export interface ConnectionProfile extends ConnectionSection { profile: string; revokedGenerations: Record<string, boolean> }
export interface ConnectionReference { id: string; kind: string; version: number; generation: string; grantEpoch?: number }
export interface ConnectionSnapshot { agentId: string; profile?: string; version: number; connections: ConnectionReference[] }
