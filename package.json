{
  "name": "@chrissliu/neuma",
  "version": "0.1.0-preview.2",
  "description": "NEUMA 本机智能体与项目工作台（Apple 芯片 Mac 试用版）",
  "private": false,
  "type": "module",
  "bin": {
    "neuma": "bin/neuma.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chriss09-ui/NEUMA.git"
  },
  "files": [
    "src/",
    "npm-shrinkwrap.json",
    "bin/",
    "public/",
    "scripts/check-release.mjs",
    "scripts/check-preview-release.mjs",
    "README.md",
    "docs/images/readme-workspace.jpg",
    "docs/images/readme-projects.jpg"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "preview",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:browser": "node scripts/run-tests.mjs browser",
    "package:prepare": "node scripts/prepare-package.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:preview:check": "node scripts/check-preview-release.mjs",
    "prepublishOnly": "node scripts/check-preview-release.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@kreuzberg/node": "4.10.2",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "ajv": "8.20.0",
    "katex": "0.19.0",
    "marked": "18.1.1",
    "semver": "7.8.5",
    "sharp": "0.35.5"
  }
}
