# 小米 MiMo 按量付费接口；Token Plan 请换成控制台提供的专属地址并加 /chat/completions
NEUMA_LLM_CHAT_URL=https://api.xiaomimimo.com/v1/chat/completions
NEUMA_LLM_MODEL=mimo-v2.6-pro
NEUMA_LLM_TIMEOUT_MS=90000
NEUMA_LLM_API_KEY=
# 项目助手 Pi SDK 复用以上配置；模型接口需要支持流式回复和工具调用

# TypeSafe Jev Key；不要把真实密钥提交到代码仓库
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0

PORT=3000
